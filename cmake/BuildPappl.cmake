cmake_minimum_required(VERSION 3.23)

if(NOT DEFINED PREFIX)
    message(FATAL_ERROR "Set PREFIX to the private PAPPL install directory")
endif()
get_filename_component(PREFIX "${PREFIX}" ABSOLUTE)
if(NOT DEFINED WORK)
    set(WORK "${CMAKE_CURRENT_BINARY_DIR}/build/pappl")
endif()
get_filename_component(WORK "${WORK}" ABSOLUTE)
set(version 1.3.1)
set(hash 78aabf3d27f36e993462b1d39b5bf8c39458492fa758e5e721978fcc39c9a795)
set(source "${WORK}/pappl-${version}")
set(patch "${CMAKE_CURRENT_LIST_DIR}/../pappl_spool.patch")
file(MAKE_DIRECTORY "${WORK}")

if(NOT DEFINED PAPPL_ARCHIVE)
    set(PAPPL_ARCHIVE "${WORK}/pappl-${version}.tar.gz")
    if(NOT EXISTS "${PAPPL_ARCHIVE}")
        file(DOWNLOAD "https://github.com/michaelrsweet/pappl/releases/download/v${version}/pappl-${version}.tar.gz"
            "${PAPPL_ARCHIVE}.partial" EXPECTED_HASH "SHA256=${hash}" TLS_VERIFY ON TIMEOUT 120)
        file(RENAME "${PAPPL_ARCHIVE}.partial" "${PAPPL_ARCHIVE}")
    endif()
endif()
file(SHA256 "${PAPPL_ARCHIVE}" received)
if(NOT received STREQUAL hash)
    message(FATAL_ERROR "PAPPL source checksum does not match")
endif()

file(SHA256 "${patch}" patch_hash)
if(EXISTS "${source}/.open-braille-patch")
    file(READ "${source}/.open-braille-patch" applied)
    if(NOT applied STREQUAL patch_hash)
        message(FATAL_ERROR "Use a fresh WORK directory for a different PAPPL patch")
    endif()
else()
    file(ARCHIVE_EXTRACT INPUT "${PAPPL_ARCHIVE}" DESTINATION "${WORK}")
    execute_process(COMMAND patch --batch --fuzz=0 -p1 -i "${patch}"
        WORKING_DIRECTORY "${source}" COMMAND_ERROR_IS_FATAL ANY)
    file(WRITE "${source}/.open-braille-patch" "${patch_hash}")
endif()

if(NOT DEFINED JOBS)
    set(JOBS 2)
endif()
execute_process(COMMAND ./configure --disable-static --disable-libjpeg --disable-libpng --disable-libusb
    --disable-pam --with-tls=gnutls --with-dnssd=avahi
    WORKING_DIRECTORY "${source}" COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND make -C pappl -j${JOBS} WORKING_DIRECTORY "${source}" COMMAND_ERROR_IS_FATAL ANY)
file(GLOB library "${source}/pappl/libpappl.so.*")
if(NOT library)
    message(FATAL_ERROR "The patched PAPPL library was not built")
endif()
file(COPY ${library} DESTINATION "${PREFIX}/lib" FOLLOW_SYMLINK_CHAIN)
file(CREATE_LINK libpappl.so.1 "${PREFIX}/lib/libpappl.so" SYMBOLIC)
file(COPY "${source}/pappl/" DESTINATION "${PREFIX}/include/pappl" FILES_MATCHING
    PATTERN "*.h" PATTERN "*-private.h" EXCLUDE)
file(COPY "${PAPPL_ARCHIVE}" "${source}/LICENSE" "${source}/NOTICE" "${patch}" DESTINATION "${PREFIX}/share/pappl")
